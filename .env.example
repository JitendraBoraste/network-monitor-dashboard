# Copy this file to ".env" for local development. Never commit the real .env file.

# ---- Storage backend: sqlite | mysql | mongodb ------------------------------------
DB_BACKEND=sqlite

# SQLite (default) - path is optional
# SQLITE_PATH=./data/netmon.db

# MySQL (DB_BACKEND=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=netmon
MYSQL_PASSWORD=change-me-to-a-strong-password
MYSQL_DATABASE=netmon
# MYSQL_SSL_CA=/path/to/ca.pem
# MYSQL_SSL_DISABLED=false
# MYSQL_POOL_SIZE=5

# MongoDB (DB_BACKEND=mongodb) - local server or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=netmon

# ---- Scanning ------------------------------------------------------------------------
SCAN_TIMEOUT_SECONDS=3
HTTP_TIMEOUT_SECONDS=5
REFRESH_INTERVAL_SECONDS=15
SCAN_CACHE_TTL_SECONDS=10
# TARGETS_FILE=./targets.json
# TARGETS_JSON=[{"name":"Core DNS","address":"8.8.8.8","type":"dns"}]

# ---- Background scheduler (keeps building history with no browser open) -----------
ENABLE_BACKGROUND_SCHEDULER=false
BACKGROUND_SCAN_SECONDS=60

# ---- Data retention (days, 0 = keep forever) ---------------------------------------
LOG_RETENTION_DAYS=30

# ---- Server ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=*
